{
  "rules": {
    "claims": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === auth.uid",
        ".validate": "$code.matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$/) && newData.isString() && newData.val().length < 64"
      }
    },
    "links": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "$deviceUid": {
          ".read": "auth != null && auth.uid === $ownerUid",
          ".write": "auth != null && auth.uid === $ownerUid && (newData.child('code').val() === null || root.child('claims/'+newData.child('code').val()).val() === $deviceUid)",
          ".validate": "newData.hasChildren(['code']) || !newData.exists()",
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$/)"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "users": {
      "$uid": {
        "private": {
          "claimCode": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "smart_coaster": {
          ".read": "auth != null && (auth.uid === $uid || root.child('links/'+auth.uid+'/'+$uid).exists())",
          "telemetry": {
            ".write": "auth != null && auth.uid === $uid",
            "weight_g": {
              ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 5000"
            },
            "water_ml": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "temp_c": {
              ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 100"
            },
            "humidity_pct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "fsm_state": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "remaining_sec": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            },
            "target_interval_min": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
            },
            "total_ml": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000"
            },
            "drink_count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "refill_count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "cheat_count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "muted": {
              ".validate": "newData.isBoolean()"
            },
            "standby": {
              ".validate": "newData.isBoolean()"
            },
            "hb": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "config": {
            ".write": "auth != null && (auth.uid === $uid || root.child('links/'+auth.uid+'/'+$uid).exists())",
            "timer_mode": {
              ".validate": "newData.isString() && (newData.val() === 'DEMO' || newData.val() === 'AUTO_DHT' || newData.val() === 'MANUAL')"
            },
            "manual_interval_min": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 180"
            },
            "empty_cup_weight_g": {
              ".validate": "newData.isNumber() && newData.val() >= 35 && newData.val() <= 300"
            },
            "muted": {
              ".validate": "newData.isBoolean()"
            },
            "tare_at": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "daily": {
            "$date": {
              ".write": "auth != null && (auth.uid === $uid || root.child('links/'+auth.uid+'/'+$uid).exists())",
              ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
              "total_ml": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000"
              },
              "drink_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "refill_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "cheat_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "ml": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000"
              },
              "goal": {
                ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 10000"
              },
              "drinks": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "claimCode": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$/)"
          },
          "session": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('links/'+auth.uid+'/'+$uid).exists() && (!data.exists() || data.child('active').val() === false || data.child('owner').val() === '' || data.child('owner').val() === auth.uid) && (newData.child('owner').val() === auth.uid || !newData.child('owner').exists() || newData.child('owner').val() === '')))",
            "owner": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "started_at": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "ended_at": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "active": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}

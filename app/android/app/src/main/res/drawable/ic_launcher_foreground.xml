<?xml version="1.0" encoding="utf-8"?>
<!-- Lapisan depan adaptive icon. Digambar sebagai vektor, bukan PNG, supaya
     tajam di semua kerapatan tanpa lima berkas terpisah.

     Air diklip ke bentuk gelas. Tanpa klip, persegi panjang air menonjol keluar
     dari dinding gelas yang meruncing dan menutupi garis luarnya. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- Tatakan: benda yang membedakan produk ini, jadi digambar lebih dulu. -->
    <path
        android:fillColor="#44C8E6"
        android:fillAlpha="0.42"
        android:pathData="M44,126 h104 a11,11 0 0 1 0,22 h-104 a11,11 0 0 1 0,-22 z" />

    <!-- Dinding gelas, bagian dalam diisi warna panel. -->
    <path
        android:fillColor="#132B35"
        android:pathData="M62,46 L130,46 L115,126 Q114,131 109,131 L83,131 Q78,131 77,126 Z" />

    <!-- Air, dipotong tepat oleh bentuk gelas yang sama. -->
    <group>
        <clip-path
            android:pathData="M62,46 L130,46 L115,126 Q114,131 109,131 L83,131 Q78,131 77,126 Z" />
        <path
            android:fillColor="#44C8E6"
            android:pathData="M50,78 h92 v70 h-92 z" />
    </group>

    <!-- Garis luar digambar terakhir agar tetap tegas di atas air. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#44C8E6"
        android:strokeWidth="5"
        android:pathData="M62,46 L130,46 L115,126 Q114,131 109,131 L83,131 Q78,131 77,126 Z" />
</vector>
